Table: account, Model: Account
Fields:
> id: string;
> type: string;
> neupId: string;
> displayImage: string, nullable;
> displayName: string;
> lastActive: timestamp, nullable;

Table: domains, Model: Domain
Fields:
> id: string;
> domain: string, unique;
> name: string;
> lastCrawled: timestamp, nullable;
> crawlWorkerId: string, nullable;
> crawlLeaseUntil: timestamp, nullable;
> status: enum(discovered, requesting, requested, paused, toCrawl, crawling, crawled, analyzing, analyzed, indexed, unlisted, deleting);
> addedOn: timestamp, default: now;
> analyzedOn: timestamp, nullable;
> details: json, nullable;
> categories: string, nullable, varchar(256);

Table: crawler_workers, Model: CrawlerWorker
Fields:
> id: string;
> status: enum(Starting, Idle, Working, Stopped, Error);
> activity: string;
> siteId: string, nullable;
.. references domains.id;
> siteUrl: string, nullable;
> currentUrl: string, nullable;
> startedAt: timestamp, default: now;
> lastSeenAt: timestamp, default: now;

Table: sitemap, Model: Sitemap
Fields:
> id: string, default: cuid;
> siteId: string;
.. references domains.id;
> sitemapUrl: string;
> referrer: string, nullable;
> addedOn: timestamp, default: now;

Table: page, Model: Page
Fields:
> id: string, default: cuid;
> domainId: string;
.. references domains.id;
> url: string;
> title: string, nullable;
> description: string, nullable;
> type: string;
> details: json, nullable;
> content: text, nullable;
> category: string, nullable, varchar(256);
> status: enum(discovered, requesting, requested, toCrawl, crawling, crawled, analyzing, analyzed, indexed, unlisted, deleting);
> statusCode: int, nullable;
> discoveredOn: timestamp, nullable;
> analyzedOn: timestamp, nullable;
> crawledOn: timestamp, nullable;
> lastCrawled: timestamp, nullable;
> crawlLeaseUntil: timestamp, nullable;

Table: Resources, Model: Resource
Fields:
> id: string, default: cuid;
> type: string;
> linkFrom: string;
> linkTo: string;
> fromDomain: string;
.. references domains.id;
> toDomain: string;
.. references domains.id;
> sourcePageId: string, nullable;
> targetPageId: string, nullable;
> sourceType: string, nullable;
> anchorText: string, nullable;
> altText: string, nullable;
> titleText: string, nullable;
> rel: string, nullable;
> metadata: json, nullable;
> firstCrawlOn: timestamp, default: now;
