// Prisma schema for Postgres replacing previous Firebase/Firestore data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DomainStatus {
  Requested
  Pending
  Active
  Paused
  Error
  Crawling
  Crawled
  Cancelled
  Stopped
}

model Account {
  id           String    @id
  type         String
  neupId       String
  displayImage String?
  displayName  String
  lastActive   DateTime?

  @@index([neupId])
  @@map("account")
}

model Domain {
  id              String       @id
  domain          String       @unique
  name            String
  lastCrawled     DateTime?
  crawlWorkerId   String?
  crawlLeaseUntil DateTime?
  status          DomainStatus
  addedOn         DateTime     @default(now())
  details         Json?
  categories      String?      @db.VarChar(256)

  pages     Page[]
  linksFrom Link[]    @relation("FromDomainLinks")
  linksTo   Link[]    @relation("ToDomainLinks")
  sitemaps  Sitemap[]

  @@index([addedOn])
  @@index([status])
  @@index([status, crawlLeaseUntil])
  @@map("domains")
}

model Sitemap {
  id         String   @id @default(cuid())
  siteId     String
  sitemapUrl String
  referrer   String?
  addedOn    DateTime @default(now())

  site Domain @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, sitemapUrl])
  @@index([addedOn])
  @@index([siteId])
  @@index([sitemapUrl])
  @@map("sitemap")
}

model Page {
  id              String    @id @default(cuid())
  domainId        String
  url             String
  title           String?
  description     String?
  type            String
  data            Json[]    @default([])
  details         Json?
  content         String?   @db.Text
  category        String?   @db.VarChar(256)
  status          String
  statusCode      Int?
  addedOn         DateTime  @default(now())
  lastCrawled     DateTime?
  crawlWorkerId   String?
  crawlLeaseUntil DateTime?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([addedOn])
  @@index([domainId])
  @@index([status])
  @@index([url])
  @@index([status, crawlLeaseUntil])
  @@map("page")
}

model Link {
  id           String   @id @default(cuid())
  linkFrom     String
  linkTo       String
  fromDomain   String
  toDomain     String
  sourcePageId String?
  targetPageId String?
  sourceType   String?
  anchorText   String?
  altText      String?
  titleText    String?
  rel          String?
  firstCrawlOn DateTime @default(now())

  from Domain @relation("FromDomainLinks", fields: [fromDomain], references: [id], onDelete: Cascade)
  to   Domain @relation("ToDomainLinks", fields: [toDomain], references: [id], onDelete: Cascade)

  @@unique([linkFrom, linkTo, fromDomain, toDomain])
  @@index([firstCrawlOn])
  @@index([fromDomain])
  @@index([toDomain])
  @@index([sourcePageId])
  @@index([targetPageId])
  @@index([sourceType])
  @@index([linkFrom])
  @@index([linkTo])
  @@map("Links")
}
