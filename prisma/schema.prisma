// Prisma schema for Postgres replacing previous Firebase/Firestore data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkflowStatus {
  discovered
  requesting
  requested
  paused
  toCrawl
  crawling
  crawled
  analyzing
  analyzed
  indexed
  unlisted
  deleting
}

enum PageWorkflowStatus {
  discovered
  requesting
  requested
  toCrawl
  crawling
  crawled
  analyzing
  analyzed
  indexed
  unlisted
  deleting
}

enum CrawlerWorkerStatus {
  Starting
  Idle
  Working
  Stopped
  Error
}

model Account {
  id           String    @id
  type         String
  neupId       String
  displayImage String?
  displayName  String
  lastActive   DateTime?

  @@index([neupId])
  @@map("account")
}

model Domain {
  id              String         @id
  domain          String         @unique
  name            String
  lastCrawled     DateTime?
  crawlWorkerId   String?
  crawlLeaseUntil DateTime?
  status          WorkflowStatus
  addedOn         DateTime       @default(now())
  analyzedOn      DateTime?
  details         Json?
  categories      String?        @db.VarChar(256)

  pages          Page[]
  crawlerWorkers CrawlerWorker[]
  resourcesFrom  Resource[]      @relation("FromDomainResources")
  resourcesTo    Resource[]      @relation("ToDomainResources")
  sitemaps       Sitemap[]

  @@index([addedOn])
  @@index([status])
  @@index([status, crawlLeaseUntil])
  @@map("domains")
}

model CrawlerWorker {
  id         String              @id
  status     CrawlerWorkerStatus
  activity   String
  siteId     String?
  siteUrl    String?
  currentUrl String?
  startedAt  DateTime            @default(now())
  lastSeenAt DateTime            @default(now())

  site Domain? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([lastSeenAt])
  @@index([status, lastSeenAt])
  @@map("crawler_workers")
}

model Sitemap {
  id         String   @id @default(cuid())
  siteId     String
  sitemapUrl String
  referrer   String?
  addedOn    DateTime @default(now())

  site Domain @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, sitemapUrl])
  @@index([addedOn])
  @@index([siteId])
  @@index([sitemapUrl])
  @@map("sitemap")
}

model Page {
  id              String             @id @default(cuid())
  domainId        String
  url             String
  title           String?
  description     String?
  type            String
  details         Json?
  content         String?            @db.Text
  category        String?            @db.VarChar(256)
  status          PageWorkflowStatus
  statusCode      Int?
  discoveredOn    DateTime?
  analyzedOn      DateTime?
  crawledOn       DateTime?
  lastCrawled     DateTime?
  crawlLeaseUntil DateTime?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([discoveredOn])
  @@index([domainId])
  @@index([status])
  @@index([url])
  @@index([status, crawlLeaseUntil])
  @@map("page")
}

model Resource {
  id           String   @id @default(cuid())
  type         String
  linkFrom     String
  linkTo       String
  fromDomain   String
  toDomain     String
  sourcePageId String?
  targetPageId String?
  sourceType   String?
  anchorText   String?
  altText      String?
  titleText    String?
  rel          String?
  metadata     Json?
  firstCrawlOn DateTime @default(now())

  from Domain @relation("FromDomainResources", fields: [fromDomain], references: [id], onDelete: Cascade)
  to   Domain @relation("ToDomainResources", fields: [toDomain], references: [id], onDelete: Cascade)

  @@unique([linkFrom, linkTo, fromDomain, toDomain, type])
  @@index([firstCrawlOn])
  @@index([fromDomain])
  @@index([fromDomain, type])
  @@index([toDomain])
  @@index([toDomain, type])
  @@index([sourcePageId])
  @@index([targetPageId])
  @@index([sourceType])
  @@index([linkFrom])
  @@index([linkTo])
  @@map("Resources")
}
