// Prisma schema for Postgres replacing previous Firebase/Firestore data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String    @id
  type         String
  neupId       String
  displayImage String?
  displayName  String
  lastActive   DateTime?

  @@index([neupId])
  @@map("account")
}

model Domain {
  id          String    @id @default(cuid())
  domain      String    @unique
  name        String
  lastCrawled DateTime?
  status      String
  addedOn     DateTime  @default(now())
  details     Json?

  pages Page[]
  sourceLinks Link[] @relation("SourceDomainLinks")
  targetLinks Link[] @relation("TargetDomainLinks")

  @@index([addedOn])
  @@index([status])
  @@map("domains")
}

model Page {
  id          String    @id @default(cuid())
  domainId    String
  url         String
  title       String?
  description String?
  type        String
  data        Json[]    @default([])
  fullContent String?   @db.Text
  status      String
  statusCode  Int?
  addedOn     DateTime  @default(now())
  lastCrawled DateTime?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  sourceLinks Link[] @relation("SourcePageLinks")
  targetLinks Link[] @relation("TargetPageLinks")

  @@index([addedOn])
  @@index([domainId])
  @@index([status])
  @@index([url])
  @@map("page")
}

model Link {
  id             String   @id @default(cuid())
  sourceDomainId String
  targetDomainId String
  sourcePageId   String?
  targetPageId   String?
  sourceUrl      String
  targetUrl      String
  anchorText     String?
  rel            String?
  type           String
  addedOn        DateTime @default(now())

  sourceDomain Domain @relation("SourceDomainLinks", fields: [sourceDomainId], references: [id], onDelete: Cascade)
  targetDomain Domain @relation("TargetDomainLinks", fields: [targetDomainId], references: [id], onDelete: Cascade)
  sourcePage   Page?  @relation("SourcePageLinks", fields: [sourcePageId], references: [id], onDelete: SetNull)
  targetPage   Page?  @relation("TargetPageLinks", fields: [targetPageId], references: [id], onDelete: SetNull)

  @@index([addedOn])
  @@index([sourceDomainId])
  @@index([targetDomainId])
  @@index([sourcePageId])
  @@index([targetPageId])
  @@index([targetUrl])
  @@map("Links")
}
